# AI Provider: "anthropic" (default) or "openai"
# AI_PROVIDER=anthropic

# Anthropic API (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API (used when AI_PROVIDER=openai)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o

# ---- 改码 Worker（自动监听队列并修改源文件）----
# Worker 调用的是 OpenAI 兼容的 /v1/chat/completions 端点，
# 把 DEEPSEEK_BASE_URL 指向任意兼容服务即可切换模型，无需改代码。
DEEPSEEK_API_KEY=your-api-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 切换到其它 OpenAI 兼容服务时，改这三项即可：
# DEEPSEEK_BASE_URL=https://<your-openai-compatible-host>
# DEEPSEEK_MODEL=<model-name>
# DEEPSEEK_API_KEY=<your-key>

# Server port (default: 3771)
# PORT=3771
